{
  "name": "crm-representantes",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "dominio",
    "extrator",
    "server",
    "web",
    "deploy"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace web",
    "dev:real": "npm run dev:real --workspace web",
    "dev:admin": "npm run dev:admin --workspace web",
    "dev:servidor": "npm run dev --workspace server",
    "foto": "npm run foto --workspace extrator --",
    "enviar": "npm run enviar --workspace extrator --",
    "admin": "npm run admin --workspace server --",
    "pacote": "npm run pacote --workspace deploy --",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
