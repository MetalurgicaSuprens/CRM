# A API do CRM e a da administração (server/src/principal.ts), só em 127.0.0.1, atrás do Apache.
# Confinada: lê a versão em uso e a pasta da foto, grava só em /var/lib/crm e não sai desta máquina.
# Para conferir o confinamento: systemd-analyze security crm
[Unit]
Description=CRM dos representantes (API)
After=network.target

[Service]
Type=simple
User=crm
Group=crm
Environment=NODE_ENV=production
WorkingDirectory=/opt/crm/atual/server
ExecStart=/usr/bin/node src/principal.ts
Restart=on-failure
RestartSec=5
UMask=0077

StateDirectory=crm
StateDirectoryMode=0700
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
IPAddressDeny=any
IPAddressAllow=localhost

[Install]
WantedBy=multi-user.target
