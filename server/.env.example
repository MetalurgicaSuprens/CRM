# Configuração do servidor. Copie para server/.env (fora do git).
# Porta da API, sempre em 127.0.0.1 (o Vite e, na produção, o Apache ficam na frente).
CRM_PORTA=5176
# Pasta onde o extrator grava as fotos (relativa a server/).
CRM_PASTA_DAS_FOTOS=../data/fotos
# Só neste computador, até o login (F3): o login de teste e os códigos de representante que ele puxa.
# Nunca na produção: o servidor recusa subir com NODE_ENV=production.
CRM_SESSAO_DE_TESTE_NOME=
CRM_SESSAO_DE_TESTE_CODIGOS=
