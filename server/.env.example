# Configuração do servidor. Copie para server/.env (fora do git). Neste computador, todas são opcionais.
# Porta da API, sempre em 127.0.0.1 (o Vite e, na produção, o Apache ficam na frente).
CRM_PORTA=5176
# Pasta onde o extrator entrega as fotos, cada uma com o manifesto (relativa a server/). Na produção,
# a pasta do SFTP.
CRM_PASTA_DE_ENTRADA=../data/fotos
# Pasta só do servidor: ele copia a foto para cá, confere a cópia com o manifesto e usa a cópia.
CRM_PASTA_DAS_FOTOS_CONFERIDAS=../data/fotos-conferidas
# O app.db: logins, chaves de acesso, sessões e auditoria (relativo a server/). Fica fora do git.
CRM_ARQUIVO_DO_APP=../data/app.db
# O endereço do CRM, como o navegador o mostra: a chave de acesso fica presa a esse domínio, e os
# pedidos que alteram algo só valem dele. Neste computador, o padrão é http://localhost:5175.
# Na produção é obrigatório e com https (ex.: https://crm.suprens.com.br); o domínio não muda depois.
CRM_ORIGEM=
# A API da administração, também só em 127.0.0.1, e o endereço do site dela, que nunca fica na internet.
# Neste computador, o padrão é http://localhost:5179. Na produção, é obrigatório: https, ou
# http://localhost para quem abre a administração por um túnel SSH até o servidor.
CRM_PORTA_DO_ADMIN=5178
CRM_ORIGEM_DO_ADMIN=
