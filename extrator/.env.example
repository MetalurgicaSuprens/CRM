# Acesso do extrator ao Oracle (só leitura). Copie para extrator/.env (fora do git).
ORACLE_USER=
ORACLE_PASSWORD=
ORACLE_HOST=
ORACLE_PORT=1521
ORACLE_SERVICE_NAME=

# Envio da foto ao servidor do CRM (npm run enviar). Neste computador, sem ele, a foto fica em data/fotos.
# O endereço do servidor; a porta e o usuário da conta de troca de arquivos têm padrão (22 e crm-troca).
# As chaves ficam em data/envio/: chave-do-extrator (só a conta do extrator pode ler) e servidor-conhecido.
CRM_SERVIDOR=
CRM_SERVIDOR_PORTA=22
CRM_SERVIDOR_USUARIO=crm-troca
