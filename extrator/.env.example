# Acesso do extrator ao Oracle (só leitura). Copie para extrator/.env (fora do git).
ORACLE_USER=
# A senha vai entre aspas simples: sem elas, o que vem depois de um # é lido como comentário e some.
ORACLE_PASSWORD=''
ORACLE_HOST=
ORACLE_PORT=1521
ORACLE_SERVICE_NAME=
# Na conta do extrator (CRM_EXTRATOR), CRM_DADOS: as tabelas com dados bancários (CRCL, CFOR, NFME e
# VEPM) vêm das views desse esquema, sem essas colunas (docs/conta-oracle-do-crm.md). Vazio, ABC71: a
# conta de desenvolvimento lê as tabelas.
ORACLE_ESQUEMA_DAS_VIEWS=
# A gravação no SGI dos pedidos conferidos do CRM (npm run pedidos): "ligado" ou "desligado" (o padrão).
# Fica desligada até o primeiro pedido de teste com o Lucas (docs/pedido-no-sgi.md).
CRM_GRAVAR_NO_SGI=

# Envio da foto ao servidor do CRM (npm run enviar). Neste computador, sem ele, a foto fica em data/fotos.
# O endereço do servidor; a porta e o usuário da conta de troca de arquivos têm padrão (22 e crm-troca).
# As chaves ficam em data/envio/: chave-do-extrator (só a conta do extrator pode ler) e servidor-conhecido.
CRM_SERVIDOR=
CRM_SERVIDOR_PORTA=22
CRM_SERVIDOR_USUARIO=crm-troca
